# ==============================================================================
# Problem 1 — Cost-Efficient RAG Service Environment Variables
# ==============================================================================
RAG_VECTOR_STORE=sqlite-vec
RAG_SQLITE_DB_PATH=problem1_rag/data/rag_vectors.db
RAG_FAISS_INDEX_DIR=problem1_rag/data/faiss_index
RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150
RAG_EMBEDDING_PROVIDER=local-bge-384
RAG_EMBEDDING_MODEL=bge-small-en-v1.5-384d
RAG_EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MIN_SIMILARITY_THRESHOLD=0.26
RAG_MIN_KEYWORD_OVERLAP=0.18
RAG_LLM_PROVIDER=local-extractive-llm
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.0
RAG_QUERY_LOG_PATH=problem1_rag/results/query_audit.jsonl

# Optional live API keys (leave blank to run in deterministic offline mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Problem 2 — LLM-as-Judge Evaluation Pipeline Environment Variables
# (Judge and Generator configured independently to prevent self-enhancement bias)
# ==============================================================================
JUDGE_PROVIDER=anthropic-calibrated
JUDGE_MODEL=claude-3-5-sonnet-20241022
JUDGE_TEMPERATURE=0.0
JUDGE_API_KEY=

GENERATOR_PROVIDER=openai
GENERATOR_MODEL=gpt-4o-mini-2024-07-18
GENERATOR_TEMPERATURE=0.2
GENERATOR_API_KEY=

JUDGE_MODE=pointwise_reference_assisted
JUDGE_PASS_THRESHOLD=3.75
JUDGE_ENABLE_LENGTH_PENALTY=true
JUDGE_ENABLE_CLAIM_GROUNDING=true
JUDGE_ENABLE_FEWSHOT_ANCHORS=true
JUDGE_BIDIRECTIONAL_SWAP=true
JUDGE_AUDIT_LOG_PATH=problem2_judge/results/judge_audit_log.jsonl
